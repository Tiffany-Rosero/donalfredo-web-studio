---
/*
  Sección Contacto rediseñada con tarjeta integrada (Split Card).
*/
import Contenedor from "../ui/Contenedor.astro";
import Boton from "../ui/Boton.astro";
---

<section id="contacto-formulario" class="py-12 sm:py-16 md:py-24">
  <Contenedor>
    <div class="text-center" data-revelar>
      <h1 class="text-4xl font-bold tracking-tight text-texto sm:text-5xl lg:text-6xl">
        ¡Estamos para atenderte!
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base text-texto sm:text-lg">
        ¿Tienes alguna consulta sobre nuestros productos? Escríbenos, estaremos encantados de
        ayudarte. Estamos en Quito, Ecuador.
      </p>
    </div>

    <!-- Tarjeta dividida integrada (Split Card) -->
    <div
      class="mt-12 overflow-hidden rounded-marca bg-fondo shadow-marca borde-marca lg:grid lg:grid-cols-12"
      data-revelar
    >
      <!-- Lado izquierdo: Panel institucional -->
      <div
        class="flex flex-col justify-between bg-marca p-8 text-marca-contraste sm:p-12 lg:col-span-5"
      >
        <div>
          <span class="text-xs font-bold tracking-widest text-borde uppercase">
            Canales directos
          </span>

          <h2 class="mt-2 text-3xl font-bold tracking-tight text-marca-contraste">
            Información de Contacto
          </h2>

          <div class="mt-8 space-y-6">
            <!-- WhatsApp -->
            <div class="flex items-start gap-4">
              <div
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-marca bg-fondo text-marca borde-marca"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-xs font-bold text-marca-contraste uppercase opacity-75">WhatsApp</p>
                <p class="text-base font-bold text-marca-contraste">096 286 8133</p>
                <a
                  href="https://wa.me/593962868133"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-flex items-center gap-1 text-xs font-bold text-marca-contraste underline hover:opacity-85"
                >
                  <span>Escríbenos por WhatsApp</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Correo -->
            <div class="flex items-start gap-4">
              <div
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-marca bg-fondo text-marca borde-marca"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-xs font-bold text-marca-contraste uppercase opacity-75">
                  Correo electrónico
                </p>
                <p class="text-sm font-bold break-all text-marca-contraste sm:text-base">
                  provembutidos01@gmail.com
                </p>
                <a
                  href="mailto:provembutidos01@gmail.com"
                  class="mt-1 inline-flex items-center gap-1 text-xs font-bold text-marca-contraste underline hover:opacity-85"
                >
                  <span>Enviar correo</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Ubicación -->
            <div class="flex items-start gap-4">
              <div
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-marca bg-fondo text-marca borde-marca"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-xs font-bold text-marca-contraste uppercase opacity-75">Ubicación</p>
                <p class="text-sm text-marca-contraste sm:text-base">
                  J Gutiérrez S9-125, Quito, Ecuador 170121
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="mt-10 border-t border-marca-contraste/20 pt-6">
          <p class="text-xs font-bold tracking-wider text-marca-contraste uppercase opacity-80">
            Síguenos en redes sociales
          </p>
          <div class="mt-3 flex items-center gap-4">
            <a
              href="https://www.facebook.com/profile.php?id=100093854029699"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-marca bg-fondo px-3 py-1.5 text-xs font-bold text-texto transition borde-marca hover:bg-superficie hover:text-texto"
            >
              Facebook
            </a>
            <a
              href="https://www.instagram.com/embutidosdonalfredo_ec?xtok=dXJhcWR5d2MwYmRy"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-marca bg-fondo px-3 py-1.5 text-xs font-bold text-texto transition borde-marca hover:bg-superficie hover:text-texto"
            >
              Instagram
            </a>
          </div>
        </div>
      </div>

      <!-- Lado derecho: Formulario -->
      <div class="p-8 sm:p-12 lg:col-span-7">
        <h2 class="text-2xl font-bold tracking-tight text-texto sm:text-3xl">
          Envíanos un mensaje
        </h2>
        <p class="mt-2 text-sm text-texto opacity-80 sm:text-base">
          Déjanos tus datos y nos pondremos en contacto contigo a la brevedad posible.
        </p>

        <form
          class="mt-8 space-y-6"
          onsubmit="event.preventDefault(); alert('¡Gracias por comunicarte! Tu mensaje ha sido enviado correctamente.'); this.reset();"
        >
          <div class="space-y-2">
            <label for="nombre" class="text-sm font-bold text-texto"> Nombre completo </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              class="w-full rounded-marca bg-fondo px-4 py-3 text-texto transition borde-marca placeholder:text-texto/40 focus:outline-none"
              placeholder="Ej. Juan Pérez"
            />
          </div>

          <div class="space-y-2">
            <label for="correo" class="text-sm font-bold text-texto"> Correo electrónico </label>
            <input
              type="email"
              id="correo"
              name="correo"
              required
              class="w-full rounded-marca bg-fondo px-4 py-3 text-texto transition borde-marca placeholder:text-texto/40 focus:outline-none"
              placeholder="Ej. juan@correo.com"
            />
          </div>

          <div class="space-y-2">
            <label for="mensaje" class="text-sm font-bold text-texto"> Mensaje o consulta </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="4"
              required
              class="w-full rounded-marca bg-fondo px-4 py-3 text-texto transition borde-marca placeholder:text-texto/40 focus:outline-none"
              placeholder="¿Qué consulta tienes sobre nuestros embutidos o distribución?..."
            ></textarea>
          </div>

          <div class="pt-2">
            <Boton type="submit">Enviar mensaje</Boton>
          </div>
        </form>
      </div>
    </div>
  </Contenedor>
</section>
